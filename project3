#include <iostream>
#include <fstream>
#include <iomanip>
#include <cstring>

using namespace std;

class Book
{
private:
    int bookID;
    char title[50];
    char author[50];
    bool issued;

public:
 
    void addBook()
    {
        cout << "\nEnter Book ID: ";
        cin >> bookID;

        cin.ignore();

        cout << "Enter Book Title: ";
        cin.getline(title, 50);

        cout << "Enter Author Name: ";
        cin.getline(author, 50);

        issued = false;
    }
    void displayBook()
    {
        cout << left << setw(10) << bookID
             << setw(25) << title
             << setw(25) << author
             << setw(15) << (issued ? "Issued" : "Available")
             << endl;
    }
    int getBookID()
    {
        return bookID;
    }

    // Get Title
    char* getTitle()
    {
        return title;
    }

    char* getAuthor()
    {
        return author;
    }

    void issueBook()
    {
        if (issued)
        {
            cout << "\nBook Already Issued!\n";
        }
        else
        {
            issued = true;
            cout << "\nBook Issued Successfully!\n";
        }
    }

    void returnBook()
    {
        if (!issued)
        {
            cout << "\nBook is Already Available!\n";
        }
        else
        {
            issued = false;
            cout << "\nBook Returned Successfully!\n";
        }
    }
};

void addBookRecord()
{
    Book b;

    ofstream file("library.dat", ios::binary | ios::app);

    b.addBook();

    file.write((char *)&b, sizeof(b));

    file.close();

    cout << "\nBook Added Successfully!\n";
}

void displayBooks()
{
    Book b;

    ifstream file("library.dat", ios::binary);

    cout << "\n---------------- Library Books ----------------\n";

    cout << left << setw(10) << "Book ID"
         << setw(25) << "Title"
         << setw(25) << "Author"
         << setw(15) << "Status" << endl;

    cout << "------------------------------------------------------------------\n";

    while (file.read((char *)&b, sizeof(b)))
    {
        b.displayBook();
    }

    file.close();
}

void searchByTitle()
{
    Book b;

    ifstream file("library.dat", ios::binary);

    char searchTitle[50];

    bool found = false;

    cin.ignore();

    cout << "\nEnter Book Title to Search: ";
    cin.getline(searchTitle, 50);

    while (file.read((char *)&b, sizeof(b)))
    {
        if (strcmpi(b.getTitle(), searchTitle) == 0)
        {
            cout << "\nBook Found:\n";

            cout << left << setw(10) << "Book ID"
                 << setw(25) << "Title"
                 << setw(25) << "Author"
                 << setw(15) << "Status" << endl;

            b.displayBook();

            found = true;
        }
    }

    if (!found)
    {
        cout << "\nBook Not Found!\n";
    }

    file.close();
}

